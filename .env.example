# Copy to .env (never commit .env)
PORT=3000
DB_HOST=localhost
DB_USER=evapp
DB_PASSWORD=change-me
DB_NAME=ev_charge_finder
# Google Maps key (Routes, Places, Geocoding). Leave empty to use the free OSM fallback in development.
GOOGLE_MAPS_API_KEY=
# Sent to Nominatim when the fallback is used
NOMINATIM_UA=Powerbunk-dev/0.1
